<div class="mx-auto max-w-lg">
  <%= render "ui/badge", label: "Pagamento simulado", tone: :warning %>

  <h1 class="mt-3 font-display text-3xl text-wine-ink">Checkout de desenvolvimento</h1>

  <p class="mt-2 text-clay-text">
    A InfinitePay não foi chamada. Esta página existe porque
    <code>INFINITEPAY_FAKE</code> está ligado.
  </p>

  <div class="<%= ui_card_classes(extra: "mt-6 p-5") %>">
    <dl class="space-y-2 text-sm">
      <div class="flex justify-between gap-4">
        <dt class="text-clay-text">Pedido</dt>
        <dd class="font-medium"><%= @order.order_nsu %></dd>
      </div>
      <div class="flex justify-between gap-4">
        <dt class="text-clay-text">Situação</dt>
        <dd class="font-medium"><%= @order.status %></dd>
      </div>
      <div class="flex justify-between gap-4">
        <dt class="text-clay-text">Total</dt>
        <dd class="font-medium"><%= Variant.format_brl(@order.total_cents) %></dd>
      </div>
    </dl>

    <ul class="mt-4 space-y-1 border-t border-nude-deep pt-4 text-sm text-clay-text">
      <% @order.order_items.includes(variant: :product).each do |item| %>
        <li>
          <%= item.quantity %>× <%= item.variant.product.title %> — <%= item.variant.name %>
        </li>
      <% end %>
    </ul>
  </div>

  <%# Dispara o mesmo webhook que a InfinitePay dispararia. O double-check do
      ProcessWebhook cai no payment_check fake, que aprova o valor do pedido. %>
  <%= form_with url: "/webhooks/infinitepay", method: :post, class: "mt-6" do |f| %>
    <%= hidden_field_tag :order_nsu, @order.order_nsu %>
    <%= hidden_field_tag :transaction_nsu, @transaction_nsu %>
    <%= hidden_field_tag :invoice_slug, "fake-slug" %>
    <%= hidden_field_tag :amount, @order.total_cents %>
    <%= hidden_field_tag :paid_amount, @order.total_cents %>
    <%= hidden_field_tag :capture_method, "pix" %>

    <%= f.submit "Simular pagamento aprovado", class: ui_button_classes(extra: "w-full sm:w-auto") %>
  <% end %>

  <p class="mt-3 text-sm text-clay-text">
    Isso entrega o webhook ao app, que dá baixa no estoque como faria em produção.
  </p>
</div>
