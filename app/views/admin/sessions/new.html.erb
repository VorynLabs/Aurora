<div class="mx-auto max-w-sm">
  <h1 class="font-display text-3xl text-wine">Aurora</h1>
  <p class="mt-1 text-clay-text">Entre para gerenciar o estoque.</p>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name),
        html: { class: "mt-8 space-y-4" }) do |f| %>
    <div>
      <%= f.label :email, "E-mail", class: ui_label_classes %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email",
            class: ui_input_classes(extra: "mt-1") %>
    </div>

    <div>
      <%= f.label :password, "Senha", class: ui_label_classes %>
      <%= f.password_field :password, autocomplete: "current-password",
            class: ui_input_classes(extra: "mt-1") %>
    </div>

    <label class="flex items-center gap-2 text-sm text-clay-text">
      <%= f.check_box :remember_me, class: "h-4 w-4 rounded border-nude-deep text-wine" %>
      Manter conectado
    </label>

    <%= f.submit "Entrar", class: ui_button_classes(extra: "w-full") %>
  <% end %>
</div>
