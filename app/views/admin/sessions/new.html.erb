<div class="mx-auto max-w-sm">
  <h1 class="text-2xl font-medium">Aurora</h1>
  <p class="mt-1 text-neutral-600">Entre para gerenciar o estoque.</p>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name),
        html: { class: "mt-8 space-y-4" }) do |f| %>
    <div>
      <%= f.label :email, "E-mail", class: "block text-sm font-medium" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email",
            class: "mt-1 block w-full rounded-lg border border-neutral-300 px-3 py-2.5" %>
    </div>

    <div>
      <%= f.label :password, "Senha", class: "block text-sm font-medium" %>
      <%= f.password_field :password, autocomplete: "current-password",
            class: "mt-1 block w-full rounded-lg border border-neutral-300 px-3 py-2.5" %>
    </div>

    <label class="flex items-center gap-2 text-sm text-neutral-600">
      <%= f.check_box :remember_me %>
      Manter conectado
    </label>

    <%= f.submit "Entrar",
          class: "w-full rounded-lg bg-neutral-900 px-4 py-2.5 text-white hover:bg-neutral-800" %>
  <% end %>
</div>
