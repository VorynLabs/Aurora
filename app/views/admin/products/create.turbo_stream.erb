<%# Card novo no topo da lista e modal trocado por um limpo — o painel fechado
    já é o retorno visual de que deu certo. %>
<%= turbo_stream.prepend "products" do %>
  <%= render "admin/products/product", product: @product %>
<% end %>

<%= turbo_stream.replace "new_product_modal" do %>
  <%= render "admin/products/new_product_modal", product: @new_product %>
<% end %>

<%# Primeiro produto da lista: o cabeçalho das colunas entra junto. %>
<%= turbo_stream.update "products_header" do %>
  <%= render "admin/products/table_header" %>
<% end %>

<%= turbo_stream.update "products_count" do %>
  <%= render "admin/products/count", count: current_admin.products.count %>
<% end %>

<%= turbo_stream.update "products_empty", "" %>
