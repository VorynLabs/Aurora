<div class="flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl">Produtos</h1>

  <%# Contador e estado vazio ficam em elementos próprios para os turbo_streams
      de criação e remoção poderem mantê-los em dia. %>
  <p id="products_count" class="text-sm text-clay-text">
    <%= render "admin/products/count", count: @products.size %>
  </p>
</div>

<div id="products" class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  <%= render partial: "admin/products/product", collection: @products %>
</div>

<div id="products_empty">
  <%= render "admin/products/empty_state" if @products.empty? %>
</div>

<%= render "admin/products/new_product_modal", product: @new_product %>
