<%# Faixa wine-ink, mais sóbria que a do catálogo. Sem distrações. %>
<header class="bg-wine-ink text-nude">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
    <%= link_to admin_root_path, class: "font-display text-lg text-nude" do %>
      Aurora <span class="text-nude-deep">· estoque</span>
    <% end %>

    <div class="flex items-center gap-3 text-sm">
      <span class="hidden text-nude-deep sm:inline"><%= current_admin.email %></span>
      <%= button_to "Sair", destroy_admin_session_path, method: :delete,
            class: "inline-flex min-h-11 items-center rounded-control border border-nude-deep/40 px-3 text-nude hover:bg-wine-dark" %>
    </div>
  </div>
</header>
