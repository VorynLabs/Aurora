<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title>Aurora · Estoque</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-neutral-50 text-neutral-900">
    <% if admin_signed_in? %>
      <header class="border-b border-neutral-200 bg-white">
        <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-5 py-4">
          <%= link_to "Aurora · Estoque", admin_root_path, class: "font-medium" %>

          <div class="flex items-center gap-4 text-sm">
            <span class="hidden text-neutral-500 sm:inline"><%= current_admin.email %></span>
            <%= button_to "Sair", destroy_admin_session_path, method: :delete,
                  class: "rounded-lg border border-neutral-300 px-3 py-1.5 hover:bg-neutral-100" %>
          </div>
        </div>
      </header>
    <% end %>

    <main class="mx-auto max-w-5xl px-5 py-8">
      <% if notice.present? %>
        <p class="mb-6 rounded-lg bg-emerald-50 px-4 py-3 text-sm text-emerald-800"><%= notice %></p>
      <% end %>
      <% if alert.present? %>
        <p class="mb-6 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-800"><%= alert %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
